# Copy to .env.local and fill in. Never commit real values.

# Public site URL (used for metadata / absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature flag: use the undocumented EAWS-wide aggregate feed.
# Keep "false" until permission has been obtained (see PLAN.md section 5).
ENABLE_EAWS_AGGREGATE=false

# Météo-France API portal key (optional, M5b). Leave empty to link out instead.
METEOFRANCE_API_KEY=

# Set to 1 to skip all external API calls and use sample data (tests, offline development).
FORCE_MOCK_DATA=
